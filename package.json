{
    "name": "PGCD-monorepo",
    "private": true,
    "description": "Power Grid Circuit Designer Monorepo",
    "version": "1.0.0",
    "author": "Phlog0",
    "scripts": {
        "dev:client": "pnpm --filter PGCD-client dev",
        "dev:server": "pnpm --filter PGCD-server dev",
        "dev": "concurrently \"pnpm run dev:server\" \"pnpm run dev:client\"",
        "lint:client": "pnpm --filter PGCD-client lint",
        "lint:server": "pnpm --filter PGCD-server lint",
        "format": "prettier --write .",
        "typecheck:client": "pnpm --filter PGCD-client typecheck",
        "typecheck:server": "pnpm --filter PGCD-server typecheck",
        "build:client": "pnpm --filter PGCD-client build",
        "build:server": "pnpm --filter PGCD-server build",
        "test": "pnpm --filter PGCD-client test && pnpm --filter PGCD-server test",
        "test:client": "pnpm --filter PGCD-client test",
        "test:server": "pnpm --filter PGCD-server test",
        "prisma:generate": "pnpm --filter PGCD-server prisma:generate",
        "prisma:migrate": "pnpm --filter PGCD-server prisma:migrate",
        "prisma:studio": "pnpm --filter PGCD-server prisma:studio",
        "prisma:deploy": "pnpm --filter PGCD-server prisma:deploy",
        "prisma:reset": "pnpm --filter PGCD-server prisma:reset",
        "prisma:seed": "pnpm --filter PGCD-server prisma:seed",
        "prepare": "husky"
    },
    "lint-staged": {
        "apps/client/**/*.{ts,tsx, js, jsx}": [
            "pnpm --filter PGCD-client lint --fix",
            "pnpm prettier --write"
        ],
        "apps/server/**/*.{ts}": [
            "pnpm --filter PGCD-server lint --fix",
            "pnpm prettier --write"
        ],
        "*.{json,md,yml}": [
            "pnpm prettier --write"
        ]
    },
    "keywords": [],
    "license": "ISC",
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "^11.17.0",
            "onFail": "download"
        }
    },
    "engines": {
        "node": ">=24"
    },
    "type": "module",
    "devDependencies": {
        "husky": "^9.1.7",
        "lint-staged": "^17.3.0",
        "prettier": "^3.9.6"
    },
    "dependencies": {
        "concurrently": "^10.0.5"
    }
}
